# Copy to .env and adjust for local development

# PostgreSQL
POSTGRES_USER=procureai
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=procureai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://procureai:your_secure_postgres_password_here@localhost:5432/procureai

# Backend
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Authentication (JWT) — Minimum 32 characters for security
JWT_SECRET=your_super_secret_jwt_access_key_min_32_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# AI Service
ENVIRONMENT=development

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/api/v1

# Docker port overrides (optional)
BACKEND_PORT=4000
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# OSINT Public Records Enrichment (Ministry of Corporate Affairs / data.gov.in)
# Free registration required: Sign up at https://data.gov.in/ -> My Account -> API Key
MCA_OGD_API_KEY=your_free_datagov_api_key_here

